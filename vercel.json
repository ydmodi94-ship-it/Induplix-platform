{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "induplix-source": {
      "root": "Frontend/induplix-source",
      "framework": "tanstack-start-lovable"
    }
  },
  "installCommand": "npm ci", // installs devDependencies too
  "buildCommand": "npm run build", // runs `vite build`
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "induplix-source"
      }
    }
  ]
}
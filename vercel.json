{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "node-api": {
      "root": "Backend/node-api",
      "framework": "express"
    },
    "induplix-source": {
      "root": "Frontend/induplix-source",
      "framework": "tanstack-start-lovable"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "node-api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "node-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "induplix-source"
      }
    }
  ]
}

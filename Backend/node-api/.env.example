# Induplix API Configuration

# Environment mode: development | test | production
NODE_ENV=development

# Server port
PORT=5000

# Base URL for server
APP_BASE_URL=http://localhost:5000

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# MongoDB Connection URI
MONGODB_URI=mongodb+srv://ydmodi94_db_user:<db_password>@cluster0.xiqxeqk.mongodb.net/

# Session Configuration
SESSION_SECRET=change-this-to-a-very-secure-random-string-at-least-32-chars-long
SESSION_NAME=induplix.sid
SESSION_MAX_AGE_MS=86400000

# Rate limiting settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_PUBLIC=100
RATE_LIMIT_MAX_AUTH=10

